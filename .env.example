# ─────────────────────────────────────────────────────────────
#  Análise de Processos SEI · GEMAP — variáveis de ambiente
#  Copie para .env e preencha. Em produção use os secrets do Cloud Run.
# ─────────────────────────────────────────────────────────────

# 1. Gemini API (chave ÚNICA, gerada pelo administrador no Google AI Studio, tier pago)
GEMINI_API_KEY="cole-a-chave-aqui"
GEMINI_MODEL="gemini-3.8-flash"

# 2. Segredo da sessão. Gere com:  openssl rand -hex 32
SESSION_SECRET="troque-por-um-hex-de-64-caracteres"
SESSION_DAYS="7"

# 3. Primeiro acesso: no login inicial com este e-mail + esta senha, a conta vira
#    administradora e a senha fica gravada. Depois, gerencie todo mundo na tela de Administração.
BOOTSTRAP_ADMIN_EMAIL="admin@orgao.gov.br"
BOOTSTRAP_ADMIN_PASSWORD="escolha-uma-senha-forte"

# 5. Banco de dados — escolha UMA das opções:

#  (a) String de conexão (local, Neon, ou Cloud SQL via Auth Proxy)
DATABASE_URL="postgres://postgres:senha@localhost:5432/sei_gemap"

#  (b) Cloud Run + Cloud SQL (socket unix). Deixe DATABASE_URL vazio e preencha:
# INSTANCE_CONNECTION_NAME="projeto:us-central1:sei-gemap-db"
# DB_USER="postgres"
# DB_PASSWORD="senha"
# DB_NAME="sei_gemap"
